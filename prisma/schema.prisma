generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  instagramUserId String          @unique
  username        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  messages        IncomingMessage[]
  trackings       ReelTracking[]
}

model IncomingMessage {
  id             String   @id @default(cuid())
  messageId      String?  @unique
  senderId       String
  recipientId    String
  messageText    String?
  attachmentData Json?
  receivedAt     DateTime @default(now())
  processedAt    DateTime?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([senderId, receivedAt])
  @@index([processedAt])
}

model ReelTracking {
  id                 String         @id @default(cuid())
  userId             String
  originalReelUrl    String
  creatorUsername    String?
  creatorId          String?
  originalCaption    String?
  originalTimestamp  DateTime?
  status             TrackingStatus @default(pending)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  detectedReels      DetectedReel[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DetectedReel {
  id              String       @id @default(cuid())
  trackingId      String
  reelUrl         String
  caption         String?
  publishedAt     DateTime?
  confidenceScore Float?
  createdAt       DateTime     @default(now())
  tracking        ReelTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)

  @@index([trackingId, createdAt])
}

enum TrackingStatus {
  pending
  monitoring
  part_found
  completed
  failed
}
